{
  "name": "hardhat-bet-factory",
  "version": "2.0.0",
  "description": "Modern peer-to-peer betting platform with Chainlink integration",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:fork": "FORK=true hardhat test test/BetFactory-Fork.test.js",
    "test:e2e": "hardhat test test/BetFactory-E2E.test.js",
    "test:gas": "REPORT_GAS=true hardhat test",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "format": "prettier --write .",
    "coverage": "hardhat coverage",
    "deploy": "hardhat deploy",
    "deploy:sepolia": "hardhat deploy --network sepolia"
  },
  "license": "MIT",
  "devDependencies": {
    "@chainlink/env-enc": "^1.0.5",
    "@chainlink/functions-toolkit": "^0.3.2",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.6",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.10",
    "@nomicfoundation/hardhat-verify": "^1.1.1",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@typechain/ethers-v5": "^10.2.1",
    "@typechain/hardhat": "^6.1.6",
    "axios": "^1.12.2",
    "chai": "^4.3.10",
    "ethers": "^5.7.2",
    "hardhat": "^2.19.4",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-deploy": "^0.12.1",
    "hardhat-gas-reporter": "^1.0.10",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^4.1.1",
    "solidity-coverage": "^0.8.5",
    "typechain": "^8.3.2"
  },
  "dependencies": {
    "@chainlink/contracts": "^0.8.0",
    "@openzeppelin/contracts": "^4.9.5",
    "dotenv": "^16.3.1"
  }
}
